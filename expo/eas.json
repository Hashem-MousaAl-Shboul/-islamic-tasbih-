{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
  "autoIncrement": true,
  "env": {
    "KOTLIN_VERSION": "1.9.20"
  },
  "android": {
    "buildType": "app-bundle"
    }
   }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production"
      }
    }
  }
}
