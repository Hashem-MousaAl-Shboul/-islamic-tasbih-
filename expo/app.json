{
  "expo": {
    "name": "Sabbah",
    "slug": "islamic-dhikr",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sabbah",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B4332"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.islamicdhikr.sabbah",
      "buildNumber": "101",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSUserTrackingUsageDescription": "Sabbah uses this identifier only to show relevant ads that help keep the app free. Your data is never sold, and you can decline tracking without losing any features.",
        "NSPhotoLibraryUsageDescription": "Sabbah accesses your photo library only when you choose to set a custom background image. No photos are uploaded or shared."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1B4332"
      },
      "versionCode": 113,
      "package": "app.islamicdhikr.sabbah",
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "com.google.android.gms.permission.AD_ID"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#D4A853",
      "androidMode": "default"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-localization",
      "expo-location",
      "expo-mail-composer",
      "expo-audio",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4282819777610118~5450174392",
          "iosAppId": "ca-app-pub-4282819777610118~7403522538",
          "userTrackingUsageDescription": "Sabbah uses this identifier only to show relevant ads that help keep the app free. Your data is never sold, and you can decline tracking without losing any features."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "kotlinVersion": "1.9.20"
          }
        }
      ],
      "./plugins/withKotlinMetadataCompat",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#000000",
          "behavior": "overlay-swipe",
          "visibility": "hidden",
          "barStyle": "light",
          "position": "absolute"
        }
      ],
      [
        "expo-notifications",
        {
          "androidChannels": [
            {
              "id": "adhkar-reminders",
              "name": "Adhkar Reminders",
              "description": "Daily reminders for morning, evening, and after-prayer adhkar",
              "importance": "high",
              "lightColor": "#D4A853",
              "vibrationPattern": [
                0,
                250,
                250,
                250
              ]
            }
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
