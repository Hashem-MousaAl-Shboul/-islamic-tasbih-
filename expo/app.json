{
  "expo": {
    "name": "Sabbah",
    "slug": "islamic-dhikr",
    "version": "1.8.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sabbah",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B4332"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.islamicdhikr.sabbah",
      "buildNumber": "101",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "Sabbah uses this identifier only to show relevant ads that help keep the app free. Your data is never sold, and you can decline tracking without losing any features.",
        "NSPhotoLibraryUsageDescription": "Sabbah accesses your photo library only when you choose to set a custom background image. No photos are uploaded or shared."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1B4332"
      },
      "versionCode": 121,
      "targetSdkVersion": 35,
      "package": "app.islamicdhikr.sabbah",
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#D4A853",
      "androidMode": "default"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-localization",
      "expo-location",
      "expo-mail-composer",
      "expo-audio",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4282819777610118~5450174392",
          "iosAppId": "ca-app-pub-4282819777610118~7403522538",
          "userTrackingUsageDescription": "Sabbah uses this identifier only to show relevant ads that help keep the app free. Your data is never sold, and you can decline tracking without losing any features."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35
          }
        }
      ],
      "./plugins/withKotlinMetadataCompat",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#000000",
          "behavior": "overlay-swipe",
          "visibility": "hidden",
          "barStyle": "light",
          "position": "absolute"
